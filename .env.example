# Public URL of the deployed Vercel API for iOS and Android builds.
EXPO_PUBLIC_API_URL=https://your-project.vercel.app

# Keep the public web preview fully interactive before Supabase is connected.
EXPO_PUBLIC_DEMO_MODE=true

# Server-only variables. Never prefix these with EXPO_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=server-only-secret-key

# Optional server-only Gemini Developer API configuration for the AI draft assistant.
GEMINI_API_KEY=server-only-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Server callback and recovery URLs. Add these URLs to Supabase Auth redirect allow list.
AUTH_PUBLIC_URL=https://your-project.vercel.app
AUTH_RESET_WEB_URL=https://your-project.vercel.app/auth/reset
AUTH_RESET_NATIVE_URL=bailanysta://auth/reset

# E2E/staging uses a separate Supabase project and a separate Vercel preview.
STAGING_SUPABASE_URL=https://staging-project.supabase.co
STAGING_SUPABASE_PUBLISHABLE_KEY=staging-publishable-key
STAGING_SUPABASE_SECRET_KEY=staging-server-only-secret-key

# Playwright staging accounts (keep these in local shell/CI secrets only).
E2E_BASE_URL=https://staging-preview.vercel.app
E2E_EMAIL=e2e@example.com
E2E_PASSWORD=replace-with-staging-password
E2E_SIGNUP_EMAIL=signup@example.com
E2E_SIGNUP_PASSWORD=replace-with-signup-password
E2E_TARGET_USER_ID=staging-user-uuid
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=replace-with-admin-password
