  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "EXPO_PUBLIC_DEMO_MODE=${EXPO_PUBLIC_DEMO_MODE:-true} expo export --platform web --clear",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-loader ./scripts/test-ts-loader.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/*.test.ts server/*.test.ts",
    "e2e": "playwright test",
    "e2e:staging": "E2E_BASE_URL=${E2E_BASE_URL:-http://127.0.0.1:4173} playwright test e2e/staging.spec.ts",
    "qa:seed": "node scripts/qa-fixture.mjs seed",
    "qa:cleanup": "node scripts/qa-fixture.mjs cleanup"
 },
  "private": true
